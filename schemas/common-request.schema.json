{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://application-security-support-tools.invalid/schemas/common-request.schema.json",
  "title": "Security Blocker Common Request Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "blocker",
    "blocker_version",
    "operation",
    "input"
  ],
  "properties": {
    "protocol_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "blocker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "blocker_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "input": {
      "type": "object",
      "maxProperties": 64
    },
    "policy": {
      "type": "object",
      "maxProperties": 64
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
