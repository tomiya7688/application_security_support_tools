{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://application-security-support-tools.invalid/schemas/common-response.schema.json",
  "title": "Security Blocker Common Response Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "blocker",
    "blocker_version",
    "decision",
    "allowed",
    "warnings",
    "metadata"
  ],
  "properties": {
    "protocol_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "blocker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "blocker_version": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\.(0|[1-9][0-9]*))?$"
    },
    "decision": {
      "enum": [
        "allow",
        "block",
        "error"
      ]
    },
    "allowed": {
      "type": "boolean"
    },
    "output": {
      "type": "object",
      "maxProperties": 64
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "details": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "allow"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "allowed": {
            "const": true
          }
        },
        "required": [
          "output"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "properties": {
          "allowed": {
            "const": false
          }
        },
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "output"
          ]
        }
      }
    }
  ]
}
